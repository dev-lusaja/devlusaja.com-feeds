# MySQL Configuration
USE_MYSQL=true
DB_HOST=localhost
DB_PORT=3306
DB_NAME=feeds_db
DB_USER=feeds_user
DB_PASSWORD=feeds_password

# MySQL Docker Configuration (usado por docker-compose.yml)
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=feeds_db
MYSQL_USER=feeds_user
MYSQL_PASSWORD=feeds_password
MYSQL_PORT=3306

# RSSHub Configuration
RSSHUB_HOST=localhost
RSSHUB_PORT=1200
RSSHUB_BASE_URL=http://localhost:1200
# Access key para proteger tu instancia (opcional, deja vacío para acceso público)
RSSHUB_ACCESS_KEY=

# TikTok Configuration
# Opción 1: Session ID (solo si estás logueado)
# TIKTOK_SESSION_ID=

# Opción 2: Cookies completas (para modo guest/anónimo)
# Formato: "cookie1=valor1; cookie2=valor2; cookie3=valor3"
# Cookies importantes: msToken, ttwid, odin_tt, tt_chain_token
# Para obtenerlas:
# 1. Ve a https://www.tiktok.com/@migue.baena en modo incógnito
# 2. Abre DevTools (F12) > Application > Cookies
# 3. Copia los valores de: msToken, ttwid, odin_tt
# TIKTOK_COOKIE="msToken=TU_MSTOKEN; ttwid=TU_TTWID; odin_tt=TU_ODIN_TT"
