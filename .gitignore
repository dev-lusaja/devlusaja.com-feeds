.DS_Store
.vscode/
*/pycache/
__pycache__/
*.pyc

# Variables de entorno (puede contener credenciales reales de R2/Netlify en local)
.env
client_secret_REDACTED.apps.googleusercontent.com.json

# Assets generados: se despliegan directo a Netlify, ya no se commitean
# (assets/_headers SÍ se mantiene versionado, es config de deploy manual)
assets/*.json

# Caché local del Netlify CLI
.netlify/

# Base de datos
data/
# Backups de base de datos
backups/
*.sql

# Logs de automatización
logs/*.log
logs/*.log.old

# Mantener el directorio logs/
!logs/.gitkeep