  {
    "id": "96f92215-0266-5116-b1e6-4af11ede5da4",
    "title": "Test de la IA.Estas son 10 preguntas para detectar si sos orgulloso",
    "link": "https://www.lanacion.com.ar/tecnologia/10-preguntas-para-detectar-si-sos-orgulloso-segun-la-ia-nid30102025/",
    "pubDate": "2025-10-30T20:12:46+00:00",
    "description": "",
    "author": "La Nación Argentina",
    "sourceTitle": "La Nación",
    "sourceUrl": "https://www.lanacion.com.ar/tema/inteligencia-artificial-tid58563/",
    "sourceCategory": "LaNacion_AR",
    "sourceType": "notice",
