# ===============================================
# 🤖 Configuración de Automatización de Feeds
# ===============================================
# Copia este archivo a .auto_feeds.config y ajusta los valores según tus necesidades
# cp .auto_feeds.config.example .auto_feeds.config

# ============================================
# CONFIGURACIÓN DE LOGS
# ============================================

# Directorio donde se guardarán los logs
LOG_DIR="$SCRIPT_DIR/logs"

# Archivo de log principal
LOG_FILE="$LOG_DIR/auto_feeds.log"

# Archivo de log de errores
ERROR_LOG="$LOG_DIR/auto_feeds_error.log"

# Tamaño máximo del log antes de rotarlo (en bytes)
# Por defecto: 10485760 (10MB)
MAX_LOG_SIZE=10485760

# ============================================
# CONFIGURACIÓN DE DOCKER
# ============================================

# Timeout para esperar a que Docker inicie (en segundos)
DOCKER_STARTUP_TIMEOUT=60

# ============================================
# CONFIGURACIÓN DE GIT
# ============================================

# Mensaje de commit automático
# Se añadirá automáticamente la fecha y hora
GIT_COMMIT_MESSAGE="update feeds"

# Hacer push automático a GitHub después del commit
# Valores: true | false
GIT_AUTO_PUSH=true

# ============================================
# CONFIGURACIÓN DE DESCARGA DE FEEDS
# ============================================

# Forzar descarga incluso si ya se ejecutó hoy
# Valores: true | false
FORCE_DOWNLOAD=false

# ============================================
# NOTIFICACIONES
# ============================================

# Habilitar notificaciones del sistema
# Valores: true | false
ENABLE_NOTIFICATIONS=true

# Para añadir notificaciones personalizadas (Slack, Discord, etc.),
# edita la función send_notification() en auto_feeds.sh
